# Lantern configuration TEMPLATE. Git tracks this file only.
# Copy to lan_drive_config.yaml, then edit the ignored local copy.
# File browser is open within root; Terminal password is optional (off by default).
# Set or clear locally with: python lan_drive.py --set-terminal-password
# Do not put plaintext passwords here. A LAN binding exposes passwordless Terminal unless configured.
root: "."
port: 9999
host: "127.0.0.1"
title: "Lantern"
cache_dir: ""
show_hidden: true
show_system: true
default_sort: "name-asc"
default_view: "grid"
page_limit: 100
folders_first: true
search_debounce_ms: 240
terminal_enabled: true
terminal_local_bypass: true
# Empty, omitted, or "no-password" = no password (including LAN/Tailscale).
# To enable protection, create a hash locally with --set-terminal-password.
# Per-process --no-password bypasses even a stored hash without changing this YAML.
terminal_password_hash: ""
terminal_max_sessions: 16
terminal_max_buffer_chars: 204800
terminal_start_height_px: 380
terminal_mobile_extra_keys: true
thumb_fit: "cover"
folder_preview_enabled: false
folder_preview_mode: "mosaic4"
folder_preview_fit: "cover"
folder_preview_rotate: true
folder_preview_animation: "fade"
folder_preview_interval_ms: 3500
folder_preview_scan_limit: 80
folder_preview_max_items: 24
folder_preview_include_video: true
upload_auto_start: false
upload_parallel: 3
upload_conflict: "ask"
# Lanbot uses Pi's native provider/model on localhost in Full / YOLO mode ("*") by default.
# All tool, extension, MCP, model whitelist/blacklist, and thinking level policies for
# localhost and LAN are configured strictly here in YAML.
#
# ---------------------------------------------------------------------------
# MODEL WHITELIST / BLACKLIST & THINKING LEVEL GUIDE (cho localhost & lan):
# ---------------------------------------------------------------------------
# 1. Giới hạn theo danh sách cho phép (Whitelist) hoặc chặn (Blacklist):
#    - Đặt `model_mode: "whitelist"` (chỉ cho phép các model trong `models`)
#      hoặc `model_mode: "blacklist"` (chặn các model trong `models`, cho phép phần còn lại).
#    - Hỗ trợ glob pattern theo tên model (`gpt-6-*`) hoặc `provider/model` (`openai/gpt-6-luna`).
#
# 2. Giới hạn cả mức độ Thinking (`off`, `minimal`, `low`, `medium`, `high`, `xhigh`):
#    - Cách A (Giới hạn theo từng model trong `models`):
#        model_mode: "whitelist"
#        models:
#          - model: "gpt-6-luna"
#            thinking: ["low", "high"]
#          # Hoặc viết gọn trên 1 dòng:
#          - "gpt-6-luna thinking:[low, high]"
#    - Cách B (Giới hạn chung cho toàn bộ scope `lan` hoặc `localhost`):
#        thinking: ["low", "high"]
# ---------------------------------------------------------------------------
lantern_bot:
  enabled: true
  access:
    localhost:
      # Full / YOLO local Pi mode ("*"): no restrictive --tools, --no-extensions, or --no-mcp
      # flags are injected unless explicitly restricted below.
      tools: ["*"]
      extensions: true
      mcp: true
      provider_mode: "all"       # all | whitelist | blacklist
      providers: []
      model_mode: "all"          # all | whitelist | blacklist
      models: []
      # Example model whitelist/blacklist + thinking restriction for localhost:
      # model_mode: "blacklist"
      # models:
      #   - "expensive-provider/*"
      # thinking: ["off", "low", "medium", "high", "xhigh"]
      bypass_models: []
      selection:
        provider: null
        model: null
        lock_provider: false
        lock_model: false
    lan:
      # Strict per-tool enforcement for remote LAN clients, configured exclusively in YAML.
      # Add 'edit'/'write' deliberately if LAN should modify project files.
      tools: [read, grep, find, ls]
      extensions: false         # extension tool calls denied unless listed above
      mcp: false
      provider_mode: "all"       # all | whitelist | blacklist
      providers: []
      model_mode: "all"          # all | whitelist | blacklist
      models: []
      # Ví dụ: Chỉ cho phép LAN user dùng model `gpt-6-luna` với thinking `low` hoặc `high`:
      # model_mode: "whitelist"
      # models:
      #   - model: "gpt-6-luna"
      #     thinking: ["low", "high"]
      # (Hoặc viết gọn: `models: ["gpt-6-luna thinking:[low, high]"]`)
      # Có thể đặt `thinking: ["low", "high"]` ở cấp `lan:` để áp dụng cho mọi model của LAN.
      #
      # Fully-qualified provider/model globs here bypass both lists.
      bypass_models: []
      selection:
        # null/null = keep the current allowed Pi model.
        # To lock LAN to one model, set both values and both lock flags true.
        provider: null
        model: null
        lock_provider: false
        lock_model: false
  policy:
    max_prompts_per_day: null
    max_tokens_per_day: null
  greeting: >-
    Hi! I am Lanbot, your workspace assistant.
    Select text, paste or drag files and images into chat, or type / for commands.
  lantern_context: |-
    You are LanternBot, the assistant embedded in Lantern.
    The newest <lantern_context> block is authoritative for the user's current location.
    For an active Markdown document, workingPath is the real project .md.
    Read and edit the real file directly; md_temp is only a read-only diff
    checkpoint. Ctrl+S accepts current real-file contents into md_temp.
    Do not modify the private md_temp directory yourself.
