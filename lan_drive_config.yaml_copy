# Lantern configuration TEMPLATE. Git tracks this file only.
# Copy to lan_drive_config.yaml, then edit the ignored local copy.
# File browser is open within root; Terminal password is optional (off by default).
# Set or clear locally with: python lan_drive.py --set-terminal-password
# Do not put plaintext passwords here. A LAN binding exposes passwordless Terminal unless configured.
root: "."
port: 9999
host: "127.0.0.1"
title: "Lantern"
cache_dir: ""
show_hidden: true
show_system: true
default_sort: "name-asc"
default_view: "grid"
page_limit: 100
folders_first: true
search_debounce_ms: 240
terminal_enabled: true
terminal_local_bypass: true
# Empty, omitted, or "no-password" = no password (including LAN/Tailscale).
# To enable protection, create a hash locally with --set-terminal-password.
# Per-process --no-password bypasses even a stored hash without changing this YAML.
terminal_password_hash: ""
terminal_max_sessions: 16
terminal_max_buffer_chars: 204800
terminal_start_height_px: 380
terminal_mobile_extra_keys: true
thumb_fit: "cover"
folder_preview_enabled: false
folder_preview_mode: "mosaic4"
folder_preview_fit: "cover"
folder_preview_rotate: true
folder_preview_animation: "fade"
folder_preview_interval_ms: 3500
folder_preview_scan_limit: 80
folder_preview_max_items: 24
folder_preview_include_video: true
upload_auto_start: false
upload_parallel: 3
upload_conflict: "ask"
# LanternBot uses Pi's native provider/model on localhost.
# Remote LAN clients can be independently filtered or locked below.
lantern_bot:
  enabled: true
  access:
    localhost:
      provider_mode: "all"       # all | whitelist | blacklist
      providers: []
      model_mode: "all"          # all | whitelist | blacklist
      models: []
      bypass_models: []
      selection:
        provider: null
        model: null
        lock_provider: false
        lock_model: false
    lan:
      provider_mode: "all"       # switch to whitelist/blacklist as needed
      providers: []
      model_mode: "all"
      models: []
      # Fully-qualified provider/model globs here bypass both lists.
      bypass_models: []
      selection:
        # null/null = keep the current allowed Pi model.
        # To lock LAN to one model, set both values and both lock flags true.
        provider: null
        model: null
        lock_provider: false
        lock_model: false
  policy:
    max_prompts_per_day: null
    max_tokens_per_day: null
  greeting: >-
    🦸 Tôi là LanternBot — một thành viên của biệt đội Lantern.
    Ở đâu có Lantern, ở đó có ánh sáng; file nào tối nghĩa cứ đưa đây, tôi soi cho.
  lantern_context: |-
    You are LanternBot, the assistant embedded in Lantern.
    The newest <lantern_context> block is authoritative for the user's current location.
    For an active document with workingPath, read and edit only workingPath.
    logicalPath is the saved project location and must not be written directly.
